
public void EditTeam() {

    Scanner sc2 = new Scanner(System.in);

    // 구단별 코치 저장
    String[][] coaches = new String[100][100];
    int[] coachcount = new int[100];

    // private name에 접근하기 위한 설정
    java.lang.reflect.Field field;

    try {
        field = Team.class.getDeclaredField("name");
        field.setAccessible(true);
    } catch(Exception e) {
        System.out.println("구단 이름을 읽을 수 없습니다.");
        return;
    }

    boolean editing = true;

    while(true) {

        // 구단 편집 화면
        if(editing) {

            System.out.println("<<구단 편집>>");

            for(int t=0; t<teamcount; t++) {
                try {
                    System.out.println((t+1) + ". "
                            + field.get(teams[t]));
                } catch(Exception e) {
                    System.out.println("구단 이름 오류");
                }
            }

            System.out.println((teamcount+1) + ". 나가기");
            System.out.print("편집할 구단 입력 : ");

            int num = sc2.nextInt();

            if(num == teamcount+1) {
                editing = false;
                continue;
            }

            if(num < 1 || num > teamcount) {
                System.out.println("잘못된 입력입니다.");
                continue;
            }

            int teamnum = num-1;

            while(true) {

                teams[teamnum].EditTeam();

                System.out.println("1. 코치 추가");
                System.out.println("2. 선수 추가");
                System.out.println("3. 코치 삭제");
                System.out.println("4. 선수 삭제");
                System.out.println("5. 나가기");
                System.out.print("입력 : ");

                int input = sc2.nextInt();

                switch(input) {

                case 1:
                    System.out.print("코치 이름을 입력해주세요 : ");
                    String name = sc2.next();

                    if(coachcount[teamnum] >= 100) {
                        System.out.println("코치를 더 추가할 수 없습니다.");
                        break;
                    }

                    coaches[teamnum][coachcount[teamnum]] = name;
                    coachcount[teamnum]++;

                    System.out.println(">" + name
                            + "이 출력되었습니다.");
                    break;

                case 2:
                    // 선수 추가
                    break;

                case 3:
                    System.out.println("<<코치 삭제>>");

                    if(coachcount[teamnum] == 0) {
                        System.out.println("등록된 코치가 없습니다.");
                        break;
                    }

                    for(int i=0; i<coachcount[teamnum]; i++) {
                        System.out.println((i+1) + ". "
                                + coaches[teamnum][i]);
                    }

                    System.out.print("삭제할 코치 입력 : ");
                    int del = sc2.nextInt();

                    if(del < 1 || del > coachcount[teamnum]) {
                        System.out.println("잘못된 입력입니다.");
                        break;
                    }

                    String delname = coaches[teamnum][del-1];

                    for(int i=del-1; i<coachcount[teamnum]-1; i++) {
                        coaches[teamnum][i] =
                                coaches[teamnum][i+1];
                    }

                    coachcount[teamnum]--;
                    coaches[teamnum][coachcount[teamnum]] = null;

                    System.out.println(">" + delname
                            + " 코치가 삭제되었습니다.");
                    break;

                case 4:
                    // 선수 삭제
                    break;

                case 5:
                    break;

                default:
                    System.out.println("잘못된 입력입니다.");
                }

                if(input == 5) {
                    break;
                }
            }

        } else {

            // 메인 메뉴로 돌아가기
            System.out.println("<축구선수 관리 프로그램>");
            System.out.println("1. 구단 추가");
            System.out.println("2. 구단 편집");
            System.out.println("3. 구단 삭제");
            System.out.println("4. 구단 보기");
            System.out.println("5. 프로그램 종료");
            System.out.print("입력 : ");

            int input = sc2.nextInt();

            switch(input) {

            case 1:
                System.out.println("<<구단추가>>");
                System.out.print("구단이름 입력 : ");
                String name = sc2.next();

                if(teamcount >= 100) {
                    System.out.println("구단을 더 추가할 수 없습니다.");
                    break;
                }

                teams[teamcount] = new Team(name);
                teamcount++;

                System.out.println(">구단이 생성되었습니다.");
                break;

            case 2:
                editing = true;
                break;

            case 3:
                DelTeam();
                break;

            case 4:
                AllTeam();
                break;

            case 5:
                return;

            default:
                System.out.println("잘못된 입력입니다.");
            }
        }
    }
}
